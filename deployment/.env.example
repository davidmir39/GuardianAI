# =====================================================================
# Variables de entorno opcionales para docker compose.
# Cree una copia de este fichero como `.env` y modifique lo necesario.
# Si no se define, se usaran los valores por defecto del docker-compose.
# =====================================================================

# ---------------- API ---------------------------------------------------
API_PORT=8000              # Puerto expuesto en el host para la API.
UVICORN_WORKERS=1          # Procesos uvicorn (subir si hay carga concurrente).
DEFAULT_THRESHOLD=0.5      # Fallback si los metadatos no incluyen umbral.
# THRESHOLD_OVERRIDE=0.92  # Descomentar para forzar un umbral fijo.

# ---------------- Entrenamiento ----------------------------------------
SEARCH_MODE=quick          # 'quick' (usa Hito 3) o 'full' (RandomizedSearchCV).
SEARCH_N_ITER=30
SEARCH_CV_FOLDS=3
RANDOM_STATE=42
N_JOBS=-1
# ---------------- Telegram (Hito 5) ------------------------------------
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---------------- Monitor (Hito 5) -------------------------------------
CHECK_INTERVAL=60
CPU_THRESHOLD=80.0
RAM_THRESHOLD=80.0
DRIFT_Z_THRESHOLD=3.0
FRAUD_RATE_THRESHOLD=0.10
MIN_PREDICTIONS_DRIFT=30
RETRAIN_ON_DRIFT=false
MODEL_F1_THRESHOLD=0.20     # F1 minimo sobre la ventana confirmada. Alerta si cae.
MIN_CONFIRMADOS_F1=30       # Confirmados minimos antes de evaluar F1.
ALERT_REMINDER_HOURS=1      # Recordatorio si una alerta sigue activa.